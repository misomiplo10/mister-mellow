---
export interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links: NavLink[];
  cta: NavLink;
}

const { links, cta } = Astro.props;
---

<header class="site-header" id="top">
  <nav class="nav wrap">
    <a class="brand" href="/" aria-label="Mister Mellow forside"><img src="/img/logo-orange.png" alt="Mister Mellow" /></a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    <ul class="nav-links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a class="btn btn-orange" href={cta.href}>{cta.label}</a></li>
    </ul>
  </nav>
</header>
