---
import { company } from "../data/company";
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>Shop</h4>
        <ul>
          <li><a href="/shop">Alle produkter</a></li>
          <li><a href="/shop?kategori=flower">Flower</a></li>
          <li><a href="/shop?kategori=preroll">Pre-rolls</a></li>
          <li><a href="/shop?kategori=hash">Hash</a></li>
        </ul>
      </div>
      <div>
        <h4>Info</h4>
        <ul>
          <li><a href="/#lab">Lab-rapporter</a></li>
          <li><a href="/#om">Om Mister Mellow</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h4>Forhandlere</h4>
        <ul>
          <li><a href="/forhandler">Bliv forhandler</a></li>
          <li><a href="/forhandler#vilkaar">Vilkår & levering</a></li>
          <li><a href={company.catalog} target="_blank" rel="noopener">Katalog 2026 (PDF)</a></li>
        </ul>
      </div>
      <div>
        <h4>Kontakt</h4>
        <ul>
          <li><a href={company.phoneHref}>{company.phone}</a></li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={company.instagramUrl} target="_blank" rel="noopener">{company.instagram}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <img src="/img/logo-navy.png" alt="Mister Mellow" />
      <span>© {new Date().getFullYear()} {company.legalName} · CVR {company.cvr} · Kun 18+</span>
    </div>
  </div>
</footer>

<a class="join-pill" href={company.instagramUrl} target="_blank" rel="noopener">Følg os <span aria-hidden="true">→</span></a>
