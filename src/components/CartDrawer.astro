<div class="cart-backdrop" id="cart-backdrop" hidden></div>
<aside class="cart-drawer" id="cart-drawer" aria-hidden="true" aria-label="Kurv">
  <div class="cart-head">
    <h2>Din kurv</h2>
    <button class="cart-close" data-cart-close aria-label="Luk kurv">×</button>
  </div>
  <div class="cart-empty" data-cart-empty>
    <img src="/img/logo-navy.png" alt="" />
    <p>Din kurv er tom – men det behøver den ikke at være.</p>
    <a class="btn btn-navy" href="/shop">Gå til shoppen</a>
  </div>
  <div class="cart-lines" data-cart-lines></div>
  <div class="cart-foot" data-cart-filled hidden>
    <div class="cart-total"><span>Subtotal</span><strong data-cart-subtotal>0 kr</strong></div>
    <p class="cart-note">Priser inkl. moms. Fragt beregnes ved kassen.</p>
    <a class="btn btn-orange btn-block" href="/kurv">Gå til kassen</a>
    <button class="cart-continue" data-cart-close>Fortsæt med at shoppe</button>
  </div>
</aside>
