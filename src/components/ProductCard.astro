---
import ProductVisual from "./ProductVisual.astro";
import { kr, metaLine, type Product } from "../data/products";

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
---

<article class="pcard" data-cat={p.category}>
  <div class={`pcard-media bg-${p.tint}`}>
    {p.onRequest && <span class="pcard-flag">På bestilling</span>}
    <ProductVisual visual={p.visual} />
  </div>
  <div class="pcard-body">
    <span class="pcard-brand">Mister Mellow</span>
    <h3>{p.name}</h3>
    <span class="pcard-meta">{metaLine(p)}</span>
    <p>{p.description}</p>
    <div class="pcard-price">
      {p.retail ? (
        <span><small>Vejl.</small> {kr(p.retail)}</span>
      ) : (
        <span class="muted">{p.onRequest ? "Pris på forespørgsel" : "Spørg i butikken"}</span>
      )}
      {p.size && <span class="chip">{p.size}</span>}
    </div>
    <a class="btn btn-navy btn-block" href="/#find">Find i butik</a>
  </div>
</article>
