---
import BaseLayout from "../layouts/BaseLayout.astro";
import Collection from "../components/Collection.astro";
import { products } from "../data/products";
import { labName, labResults } from "../data/lab";
import { faq } from "../data/faq";
import { company } from "../data/company";

const signature = products.filter((p) => p.category === "flower" || p.category === "preroll");
const hashAndMore = products.filter((p) => p.category === "hash" || p.category === "accessory" || p.category === "edible");
---

<BaseLayout
  title="Mister Mellow – Not your average hash"
  description="Mister Mellow er et dansk brand med medical grade Cali-flower og hash med THC-A. Lab-testet, høj styrke, gode vibes. Kun 18+."
>
  <section class="banner" aria-label="Mister Mellow">
    <div class="banner-panel banner-photo" style="background-image: url('/img/poster-thca.jpg')"></div>
    <div class="banner-panel banner-brand">
      <img src="/img/logo-navy.png" alt="Mister Mellow" />
      <p>Not your average hash.</p>
    </div>
    <div class="banner-panel banner-bud">
      <img src="/img/bud-hero.webp" alt="" width="490" height="811" />
    </div>
    <a class="pill banner-cta" href="/shop">Shop nu</a>
  </section>

  <Collection title="Signature flower & pre-rolls" products={signature} link="/shop" />

  <section class="about" id="om">
    <div class="wrap about-inner">
      <h2>Lidt highness i hver pakke.</h2>
      <p>Mister Mellow er et dansk brand med én mission: medical grade Cali-flower og hash – Fresh Frozen og Dry Sift – med THC-A. Hver sort er udvalgt hos betroede dyrkere for aroma, udseende og styrke, og alt er laboratorietestet, før det kommer i posen.</p>
      <div class="about-links">
        <a href="/shop">Shop kollektionen</a>
        <a href="#lab">Se lab-rapporterne</a>
      </div>
    </div>
  </section>

  <Collection title="Hash & tilbehør" products={hashAndMore} link="/shop?kategori=hash" />

  <section class="lab" id="lab">
    <div class="wrap">
      <div class="collection-head"><h2>Lab-rapporter</h2></div>
      <div class="lab-box">
        <table class="lab-table">
          <thead><tr><th>Sort</th><th>THC-A</th><th>Δ9-THC</th><th>CBD</th><th></th></tr></thead>
          <tbody>
            {labResults.map((r) => (
              <tr>
                <td>{r.strain}</td><td class="hi">{r.thca}</td><td>{r.d9thc}</td><td>{r.cbd}</td>
                <td><a href={r.coa} target="_blank" rel="noopener">COA ↓</a></td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="lab-note">Analyseret af {labName}. Alt testes, før det kommer i posen.</p>
      </div>
    </div>
  </section>

  <section class="faq-section" id="faq">
    <div class="wrap">
      <div class="collection-head"><h2>Spørg Mister Mellow</h2></div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}<span class="faq-ico" aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="join" id="find">
    <div class="wrap join-inner">
      <h2>Bliv en del af mellow-familien</h2>
      <p>Nye sorter, drops og hvor du finder os – først på Instagram.</p>
      <a class="pill" href={company.instagramUrl} target="_blank" rel="noopener">Følg {company.instagram}</a>
    </div>
  </section>
</BaseLayout>
