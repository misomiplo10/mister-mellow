---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { labName, labResults } from "../data/lab";
---

<BaseLayout
  title="Lab-rapporter – Mister Mellow"
  description={`Se lab-resultaterne for Mister Mellow. Alt er testet af ${labName}, før det kommer i posen.`}
>
  <section class="block page-top">
    <div class="wrap">
      <SectionTitle title="Lab-rapporter" />
      <div class="lab-panel">
        <div>
          <h3 class="panel-title">Fuld gennemsigtighed.</h3>
          <p class="panel-lead">Alt, hvad der kommer i posen, er testet af et uafhængigt laboratorium først. Se tallene selv – eller hent de fulde rapporter.</p>
          <div class="lab-badges">
            <div class="badge"><b>EMA</b><span>akkrediteret laboratorium</span></div>
            <div class="badge"><b>GMP</b><span>certificeret analyse</span></div>
          </div>
        </div>
        <div class="lab-card">
          <table class="lab-table">
            <thead><tr><th>Sort</th><th>THC-A</th><th>Δ9-THC</th><th>CBD</th></tr></thead>
            <tbody>
              {labResults.map((r) => (
                <tr><td>{r.strain}</td><td class="hi">{r.thca}</td><td>{r.d9thc}</td><td>{r.cbd}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="lab-note">Analyseret af {labName}.</p>
          <div class="lab-dl">
            {labResults.map((r) => (
              <a class="btn btn-orange btn-sm" href={r.coa} target="_blank" rel="noopener">{r.strain} COA ↓</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
