---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { company } from "../data/company";
---

<BaseLayout
  title="Find os – Mister Mellow"
  description="Mister Mellow fås hos udvalgte butikker. Følg med på Instagram for nye sorter, drops og hvor du finder os."
>
  <section class="block page-top">
    <div class="wrap find-grid">
      <div class="find-copy">
        <SectionTitle title="Hvor er Mister Mellow?" />
        <p>Mister Mellow fås hos udvalgte butikker. Spørg efter os ved kassen – eller følg med på Instagram for nye sorter, drops og hvor du finder os.</p>
        <p>Driver du selv butik? Vi leverer personligt inden for 1–2 dage, og displayet sælger for dig ved kassen.</p>
        <div class="hero-actions">
          <a class="btn btn-navy" href={company.instagramUrl} target="_blank" rel="noopener">Følg {company.instagram}</a>
          <a class="btn btn-ghost" href="/forhandler">Bliv forhandler</a>
        </div>
      </div>
      <img class="find-img" src="/img/display.jpg" alt="Mister Mellow butiksdisplay" />
    </div>
  </section>
</BaseLayout>
