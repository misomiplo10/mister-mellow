---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { categories, products } from "../data/products";

const filters = [{ id: "all", label: "Alle" }, ...categories.map((c) => ({ id: c.id, label: c.label }))];
---

<BaseLayout
  title="Kollektionen – Mister Mellow"
  description="Hele Mister Mellow-kollektionen: Cali-flower, pre-rolls og hash med THC-A, plus edibles og vapes på bestilling."
>
  <section class="block page-top">
    <div class="wrap">
      <SectionTitle title="Kollektionen" />
      <p class="page-lead">Medical grade Cali-flower og hash med THC-A. Priser er vejledende udsalgspriser inkl. moms – spørg efter Mister Mellow i din butik.</p>
      <div class="filters" role="group" aria-label="Filtrér produkter">
        {filters.map((f, i) => (
          <button class:list={["filter", { active: i === 0 }]} data-filter={f.id}>{f.label}</button>
        ))}
      </div>
      <p class="result-count" aria-live="polite"><span id="count">{products.length}</span> produkter</p>
      <div class="product-grid">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>
