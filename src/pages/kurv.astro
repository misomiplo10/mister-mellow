---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Kurv & kasse – Mister Mellow" description="Din kurv hos Mister Mellow.">
  <section class="collection page-top">
    <div class="wrap">
      <div class="collection-head"><h1>Kurv & kasse</h1></div>

      <div class="cart-empty page" data-cart-empty>
        <img src="/img/logo-navy.png" alt="" />
        <p>Din kurv er tom – men det behøver den ikke at være.</p>
        <a class="btn btn-navy" href="/shop">Gå til shoppen</a>
      </div>

      <div class="checkout" data-cart-filled hidden>
        <div class="checkout-main">
          <div class="panel">
            <h2 class="panel-h">Din kurv</h2>
            <div class="cart-lines" id="checkout-lines"></div>
          </div>

          <form class="panel checkout-form" id="checkout-form" novalidate>
            <h2 class="panel-h">Levering</h2>
            <div class="fields">
              <label class="field span-2">Fulde navn<input name="name" autocomplete="name" required /></label>
              <label class="field">E-mail<input name="email" type="email" autocomplete="email" required /></label>
              <label class="field">Telefon<input name="phone" type="tel" autocomplete="tel" required /></label>
              <label class="field span-2">Adresse<input name="address" autocomplete="street-address" required /></label>
              <label class="field">Postnr.<input name="zip" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{4}" required /></label>
              <label class="field">By<input name="city" autocomplete="address-level2" required /></label>
            </div>
            <label class="check"><input type="checkbox" name="age" required /> Jeg bekræfter, at jeg er fyldt 18 år.</label>
            <p class="form-error" id="form-error" hidden>Udfyld venligst alle felter og bekræft din alder.</p>
            <div class="notice" id="checkout-notice" hidden>
              <strong>Tak – du er klar!</strong>
              Webshoppen åbner snart. Betaling er ikke sat op endnu, så der er ikke sendt en ordre, og du er ikke blevet opkrævet.
            </div>
          </form>
        </div>

        <aside class="panel summary">
          <h2 class="panel-h">Oversigt</h2>
          <div class="sum-row"><span>Subtotal</span><span data-cart-subtotal>0 kr</span></div>
          <div class="sum-row"><span>Fragt</span><span>Beregnes ved betaling</span></div>
          <div class="sum-row total"><span>I alt</span><strong data-cart-subtotal>0 kr</strong></div>
          <p class="cart-note">Alle priser er inkl. 25 % moms.</p>
          <button class="btn btn-orange btn-block btn-lg" type="submit" form="checkout-form">Gå til betaling</button>
          <a class="cart-continue" href="/shop">Fortsæt med at shoppe</a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { bindLines, getItems, lineHtml, onChange } from "../scripts/cart";

  const lines = document.getElementById("checkout-lines")!;
  const render = () => (lines.innerHTML = getItems().map(lineHtml).join(""));
  bindLines(lines);
  onChange(render);
  render();

  // Payment isn't connected yet: validate the details, then say so plainly instead of pretending to order.
  const form = document.getElementById("checkout-form") as HTMLFormElement;
  const error = document.getElementById("form-error")!;
  const notice = document.getElementById("checkout-notice")!;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const ok = form.checkValidity();
    error.hidden = ok;
    notice.hidden = !ok;
    form.classList.toggle("tried", !ok);
    (ok ? notice : error).scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
