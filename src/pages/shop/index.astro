---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductTile from "../../components/ProductTile.astro";
import { categories, products } from "../../data/products";

const filters = [{ id: "all", label: "Alle" }, ...categories.map((c) => ({ id: c.id, label: c.label }))];
---

<BaseLayout
  title="Shop – Mister Mellow"
  description="Køb Mister Mellow online: Cali-flower, pre-rolls og hash med THC-A. Lab-testet, høj styrke, gode vibes. Kun 18+."
>
  <section class="collection page-top">
    <div class="wrap">
      <div class="collection-head">
        <h1>Shop</h1>
        <p class="result-count" aria-live="polite"><span id="count">{products.length}</span> produkter</p>
      </div>
      <div class="filters" role="group" aria-label="Filtrér produkter">
        {filters.map((f, i) => (
          <button class:list={["filter", { active: i === 0 }]} data-filter={f.id}>{f.label}</button>
        ))}
      </div>
      <div class="tile-grid product-grid">
        {products.map((p) => <ProductTile product={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>
